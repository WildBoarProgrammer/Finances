# Configurazione Database PostgreSQL per Finances App
# Copia questo file in .env e modifica con i tuoi valori

# Database URL - Sostituisci username, password, host, porta e nome database
# Configurazione Database PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/finances_db

# Sostituisci con i tuoi valori:
# DATABASE_URL=postgresql://tuo_username:tua_password@localhost:5432/finances_db

# Esempi per diversi setup:
# Local development: postgresql://postgres:password@localhost:5432/finances_db
# Remote server: postgresql://user:pass@remote-server.com:5432/finances_db
# Docker: postgresql://postgres:password@db:5432/finances_db

# Note:
# - Assicurati che PostgreSQL sia in esecuzione
# - Il database deve esistere (CREATE DATABASE finances_db;)
# - L'utente deve avere i permessi appropriati